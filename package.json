{
  "name": "qdbp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:tools": "SITE=tools astro dev",
    "build": "TZ=UTC astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "astro check",
    "check:calc": "SITE=calc pnpm build && node scripts/check-dist.mjs calc",
    "check:tools": "SITE=tools pnpm build && node scripts/check-dist.mjs tools",
    "check": "pnpm typecheck && pnpm test && pnpm check:calc && pnpm check:tools",
    "urls:update": "node scripts/check-dist.mjs calc --update-urls && node scripts/check-dist.mjs tools --update-urls"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@cantoo/pdf-lib": "2.11.1",
    "astro": "7.3.5",
    "decimal.js-light": "2.5.1",
    "fflate": "0.8.3",
    "libheif-js": "1.23.5",
    "pdfjs-dist": "6.4.299",
    "preact": "10.29.8",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "jsqr": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "ignoredOptionalDependencies": [
      "@napi-rs/canvas"
    ]
  }
}
