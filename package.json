  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "jsqr": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  },
  "pnpm": {
