{
  "title": "Loan calculator",
  "description": "Work out your monthly payment, total interest and full amortization schedule for an amortizing or equal-principal loan.",
  "inputs": {
    "amount": { "label": "Loan amount" },
    "rate": { "label": "Annual interest rate" },
    "months": { "label": "Term, months" },
