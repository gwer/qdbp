  },
  "outputs": {
    "payment": { "label": "Monthly payment" },
    "overpay": { "label": "Total interest" },
    "total": { "label": "Total paid" }
  },
  "ui": {
    "decreasing": "Payments decrease from {first} to {last}",
    "schedule": "Amortization schedule",
    "month": "Month",
    "payment": "Payment",
    "principal": "Principal",
    "interest": "Interest",
    "balance": "Balance"
  }
}
