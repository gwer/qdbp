---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ToolList from '@/components/ToolList.astro';
import { LANG_META } from '@/i18n/config';
import { uiT } from '@/i18n/ui';
import Base from '@/layouts/Base.astro';
import { categories, categoryName, categoryUrl, toolById, toolName, toolUrl, type Tool, type ToolPageProps } from '@/lib/catalog';
import { breadcrumbLd, webAppLd } from '@/lib/seo';

// Общая обвязка страницы инструмента. Сам инструмент (остров) передаётся в слот из index.astro.
type Props = Omit<ToolPageProps, 'island'>;

const { tool, lang } = Astro.props;
const t = uiT(lang);
const cat = categories.find((c) => c.id === tool.category)!;
const strings = tool.strings[lang]!;
const title = strings.title as string;
const name = toolName(tool, lang);
const description = strings.description as string;
const Content = tool.content[lang]!;

const available = (t: Tool | undefined): t is Tool => !!t && t.langs.includes(lang);
const related = (tool.def.related ?? []).map(toolById).filter(available);
const more = cat.tools.filter((t) => t !== tool && !related.includes(t) && available(t));

const crumbs = [
  { name: t('nav.home'), href: `/${lang}/` },
  { name: categoryName(cat, lang), href: categoryUrl(cat, lang) },
  { name, href: toolUrl(tool, lang) },
];
const alternates = tool.langs.map((l) => ({ lang: l, href: toolUrl(tool, l) }));
const url = new URL(toolUrl(tool, lang), Astro.site).href;
---

<Base
  lang={lang}
  title={`${title} — qdbp`}
  description={description}
  alternates={alternates}
  jsonLd={[webAppLd({ name, description, url, lang: LANG_META[lang].hreflang }), breadcrumbLd(crumbs, Astro.site!)]}
>
  <Breadcrumbs items={crumbs} />
  <h1>{title}</h1>
  <p class="lead">{description}</p>

  <div class="tool">
    <slot />
  </div>

  <article class="content">
    <Content />
  </article>

  {
    related.length > 0 && (
      <section class="related">
        <h2>{t('tool.related')}</h2>
        <ToolList tools={related} lang={lang} />
      </section>
    )
  }
  {
    more.length > 0 && (
      <section class="related">
        <h2>{t('tool.moreInCategory', { category: categoryName(cat, lang) })}</h2>
        <ToolList tools={more} lang={lang} />
      </section>
    )
  }
</Base>
