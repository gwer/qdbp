---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ToolList from '@/components/ToolList.astro';
import { uiT } from '@/i18n/ui';
import Base from '@/layouts/Base.astro';
import { categoryName, categoryUrl, toolsIn, type CategoryPageProps } from '@/lib/catalog';
import { breadcrumbLd } from '@/lib/seo';

// Общая обвязка страницы категории. Своё содержимое категории можно передать в слот из её index.astro.
type Props = CategoryPageProps;

const { cat, lang } = Astro.props;
const t = uiT(lang);
const name = categoryName(cat, lang);
const description = cat.strings[lang]!.description as string;
const tools = toolsIn(cat, lang);
const crumbs = [
  { name: t('nav.home'), href: `/${lang}/` },
  { name, href: categoryUrl(cat, lang) },
];
const alternates = cat.langs.map((l) => ({ lang: l, href: categoryUrl(cat, l) }));
---

<Base lang={lang} title={`${name} — qdbp`} description={description} alternates={alternates} jsonLd={[breadcrumbLd(crumbs, Astro.site!)]}>
  <Breadcrumbs items={crumbs} label={t('nav.breadcrumbs')} />
  <h1>{name}</h1>
  <p class="lead">{description}</p>
  <slot />
  <p class="muted">{t('category.toolsCount', { count: tools.length })}</p>
  <ToolList tools={tools} lang={lang} />
</Base>
