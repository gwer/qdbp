{
  "title": "Calculadora de dias: quantos dias entre duas datas",
  "description": "Calcule quantos dias, semanas e dias úteis (de segunda a sexta) há entre duas datas.",
  "inputs": {
    "from": {
      "label": "Data inicial"
    },
    "to": {
      "label": "Data final"
    },
    "includeEnd": {
      "label": "Contar o último dia",
      "options": {
        "no": "Não",
        "yes": "Sim (+1 dia)"
      }
    }
  },
  "outputs": {
    "days": {
      "label": "Dias"
    },
    "weeks": {
      "label": "Semanas"
    },
    "weekdays": {
      "label": "Dias úteis (seg–sex)"
    },
    "ymd": {
      "label": "Em anos, meses e dias"
    }
  },
  "ui": {
    "years": {
      "one": "{count} ano",
      "other": "{count} anos"
    },
    "months": {
      "one": "{count} mês",
      "other": "{count} meses"
    },
    "days": {
      "one": "{count} dia",
      "other": "{count} dias"
    },
    "weeks": {
      "one": "{count} semana",
      "other": "{count} semanas"
    }
  }
}
