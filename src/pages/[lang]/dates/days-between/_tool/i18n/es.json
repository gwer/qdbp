{
  "title": "Calculadora de días: cuántos días hay entre dos fechas",
  "description": "Calcula cuántos días, semanas y días laborables (de lunes a viernes) hay entre dos fechas.",
  "inputs": {
    "from": {
      "label": "Fecha de inicio"
    },
    "to": {
      "label": "Fecha final"
    },
    "includeEnd": {
      "label": "Contar el último día",
      "options": {
        "no": "No",
        "yes": "Sí (+1 día)"
      }
    }
  },
  "outputs": {
    "days": {
      "label": "Días"
    },
    "weeks": {
      "label": "Semanas"
    },
    "weekdays": {
      "label": "Días laborables (lun–vie)"
    },
    "ymd": {
      "label": "En años, meses y días"
    }
  },
  "ui": {
    "years": {
      "one": "{count} año",
      "other": "{count} años"
    },
    "months": {
      "one": "{count} mes",
      "other": "{count} meses"
    },
    "days": {
      "one": "{count} día",
      "other": "{count} días"
    },
    "weeks": {
      "one": "{count} semana",
      "other": "{count} semanas"
    }
  }
}
