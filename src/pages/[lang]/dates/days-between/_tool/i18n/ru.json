{
  "title": "Калькулятор дней: сколько дней между двумя датами",
  "description": "Посчитайте количество дней, недель и будних дней (пн–пт) между двумя датами.",
  "inputs": {
    "from": {
      "label": "Начальная дата"
    },
    "to": {
      "label": "Конечная дата"
    },
    "includeEnd": {
      "label": "Включить конечный день",
      "options": {
        "no": "Нет",
        "yes": "Да (+1 день)"
      }
    }
  },
  "outputs": {
    "days": {
      "label": "Дней"
    },
    "weeks": {
      "label": "Недель"
    },
    "weekdays": {
      "label": "Будних дней (пн–пт)"
    }
  }
}
