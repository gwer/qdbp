{
  "title": "Калькулятор дней: сколько дней между двумя датами",
  "description": "Посчитайте количество дней, недель и будних дней (пн–пт) между двумя датами.",
  "inputs": {
    "from": {
      "label": "Начальная дата"
    },
    "to": {
      "label": "Конечная дата"
    },
    "includeEnd": {
      "label": "Включить конечный день",
      "options": {
        "no": "Нет",
        "yes": "Да (+1 день)"
      }
    }
  },
  "outputs": {
    "days": {
      "label": "Дней"
    },
    "weeks": {
      "label": "Недель"
    },
    "weekdays": {
      "label": "Будних дней (пн–пт)"
    },
    "ymd": {
      "label": "В годах, месяцах и днях"
    }
  },
  "ui": {
    "years": {
      "one": "{count} год",
      "few": "{count} года",
      "many": "{count} лет",
      "other": "{count} года"
    },
    "months": {
      "one": "{count} месяц",
      "few": "{count} месяца",
      "many": "{count} месяцев",
      "other": "{count} месяца"
    },
    "days": {
      "one": "{count} день",
      "few": "{count} дня",
      "many": "{count} дней",
      "other": "{count} дня"
    },
    "weeks": {
      "one": "{count} неделя",
      "few": "{count} недели",
      "many": "{count} недель",
      "other": "{count} недели"
    }
  }
}
