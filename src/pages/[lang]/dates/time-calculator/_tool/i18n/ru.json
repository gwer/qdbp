{
  "title": "Калькулятор времени: сколько будет времени через N часов",
  "description": "Сколько будет времени через N часов и минут или сколько было N часов назад — с переходом на другой день и датой.",
  "inputs": {
    "date": {
      "label": "Дата"
    },
    "time": {
      "label": "Время"
    },
    "op": {
      "label": "Действие",
      "options": {
        "add": "Прибавить",
        "subtract": "Вычесть"
      }
    },
    "days": {
      "label": "Дней"
    },
    "hours": {
      "label": "Часов"
    },
    "minutes": {
      "label": "Минут"
    }
  },
  "outputs": {
    "time": {
      "label": "Время"
    },
    "date": {
      "label": "Дата"
    },
    "shift": {
      "label": "День"
    }
  },
  "ui": {
    "sameDay": "Тот же день",
    "nextDay": "Следующий день",
    "prevDay": "Предыдущий день",
    "daysLater": {
      "one": "Через {count} день",
      "few": "Через {count} дня",
      "many": "Через {count} дней",
      "other": "Через {count} дня"
    },
    "daysEarlier": {
      "one": "{count} день назад",
      "few": "{count} дня назад",
      "many": "{count} дней назад",
      "other": "{count} дня назад"
    }
  }
}
