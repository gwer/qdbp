    },
    "hours": {
      "one": "hour",
      "other": "hours"
    },
    "minutes": {
      "one": "minute",
      "other": "minutes"
    },
    "seconds": {
      "one": "second",
      "other": "seconds"
    },
    "weeks": {
      "one": "{n} week",
      "other": "{n} weeks"
    },
    "totals": "That’s {weeks}, or {hours} hours, or {minutes} minutes."
  }
