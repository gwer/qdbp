{
  "title": "Inflation calculator: future cost and purchasing power",
  "description": "Estimate future prices at a given inflation rate and the purchasing power of an unchanged amount of money.",
  "inputs": {
    "amount": {
      "label": "Amount today"
    },
    "rate": {
      "label": "Annual inflation rate"
    },
    "years": {
      "label": "Number of years"
    }
  },
  "outputs": {
