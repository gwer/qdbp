{
  "title": "Calculadora de propinas: propina y división de la cuenta",
  "description": "Calcula la propina y divide la cuenta: cuánto dejar de propina, el total y cuánto paga cada uno.",
  "inputs": {
    "bill": {
      "label": "Importe de la cuenta"
    },
    "percent": {
      "label": "Propina"
    },
    "people": {
      "label": "Número de personas"
    },
    "round": {
      "label": "Redondear lo de cada uno",
      "options": {
        "no": "No redondear",
        "1": "Al euro",
        "10": "A 10",
        "100": "A 100"
      }
    }
  },
  "outputs": {
    "perPerson": {
      "label": "Paga cada uno"
    },
    "tip": {
      "label": "Propina"
    },
    "total": {
      "label": "Total con propina"
    },
    "tipPerPerson": {
      "label": "Propina por persona"
    },
    "actual": {
      "label": "Propina real"
    }
  }
}
