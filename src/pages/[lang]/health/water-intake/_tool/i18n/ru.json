{
  "title": "Калькулятор нормы воды: сколько пить в день",
  "description": "Рассчитайте, сколько воды пить в день, с учётом веса, тренировок и жаркой погоды — в литрах и стаканах.",
  "inputs": {
    "weight": {
      "label": "Вес"
    },
    "exercise": {
      "label": "Тренировки в день"
    },
    "climate": {
      "label": "Погода",
      "options": {
        "normal": "Обычная",
        "hot": "Жара"
      }
    }
  },
  "outputs": {
    "total": {
      "label": "Воды в день"
    },
    "glasses": {
      "label": "В стаканах"
    }
  },
  "ui": {
    "glasses": {
      "one": "≈ {count} стакан по 250 мл",
      "few": "≈ {count} стакана по 250 мл",
      "many": "≈ {count} стаканов по 250 мл",
      "other": "≈ {count} стакана по 250 мл"
    },
    "cups": {
      "one": "≈ {count} чашка по 8 унций",
      "few": "≈ {count} чашки по 8 унций",
      "many": "≈ {count} чашек по 8 унций",
      "other": "≈ {count} чашки по 8 унций"
    }
  }
}
