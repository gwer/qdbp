{
  "title": "Calculadora de calorias: quantas calorias preciso por dia",
  "description": "Quantas calorias você precisa por dia para manter, perder ou ganhar peso, pela equação de Mifflin-St Jeor e pelo seu nível de atividade.",
  "inputs": {
    "sex": {
      "label": "Sexo",
      "options": {
        "male": "Masculino",
        "female": "Feminino"
      }
    },
    "age": {
      "label": "Idade, anos"
    },
    "weight": {
      "label": "Peso"
    },
    "height": {
      "label": "Altura"
    },
    "activity": {
      "label": "Nível de atividade",
      "options": {
        "sedentary": "Sedentário (trabalho sentado)",
        "light": "Leve (exercícios 1–3 dias por semana)",
        "moderate": "Moderado (exercícios 3–5 dias)",
        "active": "Ativo (exercícios 6–7 dias)",
        "very": "Muito ativo (trabalho físico ou treino duas vezes ao dia)"
      }
    }
  },
  "outputs": {
    "tdee": {
      "label": "Calorias para manter o peso (kcal)"
    },
    "bmr": {
      "label": "Taxa metabólica basal (kcal)"
    },
    "loss": {
      "label": "Para emagrecer (−15%) (kcal)"
    },
    "gain": {
      "label": "Para ganhar peso (+15%) (kcal)"
    }
  }
}
