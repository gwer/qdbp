      "label": "Ancho de la baldosa, cm"
    },
    "thickness": {
      "label": "Grosor de la baldosa, mm"
    },
    "joint": {
      "label": "Junta, mm"
    },
    "reserve": {
      "label": "Margen, %"
    },
    "perBox": {
