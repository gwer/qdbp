---
import Icon from '@/components/Icon.astro';
import ToolList from '@/components/ToolList.astro';
import { SITE_LANGS, type Lang } from '@/i18n/config';
import { uiT } from '@/i18n/ui';
import Base from '@/layouts/Base.astro';
import { categories, categoryName, categoryUrl, tools, toolsIn } from '@/lib/catalog';
import { SITE } from '@/site';

export function getStaticPaths() {
  return SITE_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = uiT(lang);
const cats = categories.filter((c) => c.langs.includes(lang));
// Популярное — пока по нашей оценке спроса; заменить по данным Search Console.
const POPULAR = {
  calc: [
    'finance/mortgage',
    'finance/loan-calculator',
    'math/percent-of',
    'finance/vat',
    'dates/days-between',
    'health/bmi',
    'construction/tiles',
    'kitchen/cups-to-grams',
  ],
  tools: [
    'images/compress-image',
    'images/heic-to-jpg',
    'images/resize-image',
    'images/qr-generator',
    'security/password-generator',
    'text/word-counter',
    'dev/json-formatter',
    'random/random-picker',
  ],
}[SITE];
const popular = POPULAR.map((path) => {
  const tool = tools.find((t) => t.path === path);
  if (!tool) throw new Error(`Популярное: нет инструмента ${path}`);
  return tool;
}).filter((tool) => tool.langs.includes(lang));
const alternates = SITE_LANGS.map((l) => ({ lang: l, href: `/${l}/` }));
---

<Base wide lang={lang} title={t(`site.${SITE}.title`)} description={t(`site.${SITE}.description`)} alternates={alternates}>
  <h1>{t(`site.${SITE}.tagline`)}</h1>
  <p class="lead">{t(`site.${SITE}.intro`)}</p>
  <section class="home-popular">
    <h2>{t('home.popular')}</h2>
    <ToolList tools={popular} lang={lang} icons />
  </section>
  <h2>{t('home.allCategories')}</h2>
  <nav class="home-nav" aria-label={t('home.allCategories')}>
    <ul>
      {
        cats.map((cat) => (
          <li>
            <a href={`#${cat.id}`} class="with-icon">
              <Icon svg={cat.icon} />
              {categoryName(cat, lang)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  {
    cats.map((cat) => (
      <section class="home-category" id={cat.id}>
        <h2>
          <a href={categoryUrl(cat, lang)} class="with-icon">
            <Icon svg={cat.icon} />
            {categoryName(cat, lang)}
          </a>
        </h2>
        <ToolList tools={toolsIn(cat, lang)} lang={lang} compact />
      </section>
    ))
  }
</Base>
