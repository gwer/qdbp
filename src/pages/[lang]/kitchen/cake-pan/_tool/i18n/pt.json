    "fromD": {
      "label": "Diâmetro"
    },
    "fromS": {
      "label": "Lado"
    },
    "fromL": {
      "label": "Comprimento"
    },
    "fromW": {
      "label": "Largura"
    },
    "toShape": {
      "label": "Sua forma",
      "options": {
        "round": "Redonda",
        "square": "Quadrada",
        "rect": "Retangular"
      }
    },
    "toD": {
      "label": "Diâmetro"
    },
    "toS": {
      "label": "Lado"
    },
    "toL": {
      "label": "Comprimento"
    },
    "toW": {
      "label": "Largura"
    }
