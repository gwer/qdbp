{
  "title": "Concrete calculator: cubic yards, bags and mix",
  "description": "How much concrete you need for a slab, footing or patio in cubic yards, how many 60- or 80-lb bags of premix, or how much cement, sand and gravel to mix yourself.",
  "inputs": {
    "shape": {
      "label": "What to pour",
      "options": {
        "slab": "Slab",
        "strip": "Strip footing",
        "columns": "Columns / piers"
      }
    },
    "length": {
      "label": "Length"
    },
    "width": {
      "label": "Width"
    },
    "thickness": {
      "label": "Thickness"
    },
    "reserve": {
      "label": "Extra for waste"
    },
    "premixBag": {
      "label": "Premix bag size"
    },
    "mix": {
      "label": "Mix ratio (cement : sand : gravel)",
      "options": {
        "1-2-4": "1 : 2 : 4",
        "1-2-3": "1 : 2 : 3",
        "1-3-5": "1 : 3 : 5",
        "1-3-6": "1 : 3 : 6"
      }
    },
    "bag": {
      "label": "Cement bag size"
    },
    "stripLength": {
      "label": "Total footing length"
    },
    "stripWidth": {
      "label": "Footing width"
    },
    "stripHeight": {
      "label": "Footing depth"
    },
    "diameter": {
      "label": "Column diameter"
    },
    "depth": {
      "label": "Column height"
    },
    "count": {
      "label": "Number of columns"
    }
  },
  "outputs": {
    "volume": {
      "label": "Concrete needed"
    },
    "premixBags": {
      "label": "Bags of premix"
    },
    "bags": {
      "label": "Bags of cement"
    },
    "cement": {
      "label": "Cement"
    },
    "sand": {
      "label": "Sand"
    },
    "gravel": {
      "label": "Gravel"
    },
    "water": {
      "label": "Water (approx.)"
    }
  }
}
