---
import type { Lang } from '@/i18n/config';
import { toolName, toolUrl, type Tool } from '@/lib/catalog';

interface Props {
  tools: Tool[];
  lang: Lang;
  /** Только названия, без описаний — для главной. */
  compact?: boolean;
}

const { tools, lang, compact = false } = Astro.props;
---

<ul class:list={['tool-list', { 'tool-list-compact': compact }]}>
  {
    tools.map((tool) => (
      <li>
        <a href={toolUrl(tool, lang)}>{toolName(tool, lang)}</a>
        {!compact && <p>{tool.strings[lang]!.description as string}</p>}
      </li>
    ))
  }
</ul>
